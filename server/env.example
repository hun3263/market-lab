# 이 파일은 서버의 ~/.market-lab.env 로 복사해서 쓰며, 절대 GitHub 에 올리지 않습니다.
KIWOOM_APPKEY=
KIWOOM_SECRETKEY=
# 선택: 상승 사유·테마 문장을 자동 생성하려면 입력 (없으면 기사 제목으로 대체)
ANTHROPIC_API_KEY=
# 선택: 순위표에 ETF 도 넣으려면 1
INCLUDE_ETF=0
# 선택: 종목 상세의 기업 개요(사업보고서 발췌)·3년 재무. https://opendart.fss.or.kr 에서 무료 발급(40자리)
DART_API_KEY=
# 선택: 하락 TOP5 의 거래대금 조건(키움 코드). 0=조건 없음, 1000=100억 이상, 5000=500억 이상
DOWN_AMOUNT_CND=0
